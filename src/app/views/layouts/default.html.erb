<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">

<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en">
<head>

  <meta http-equiv="content-type" content="text/html;charset=UTF-8" />

  <title><% @page_title.each do |page| %><%= (page + " - ") %><% end %><%= t('site.title_suffix') %></title>

  <%= stylesheet_link_tag 'main' %>
  <%= controller_stylesheet_link_tag %>

  <!--[if lte IE 7]><%= stylesheet_link_tag 'ie7' %><![endif]-->
  <!--[if lte IE 6]><%= stylesheet_link_tag 'ie6' %><![endif]-->

  <% if controller.action_name == 'add'            || controller.action_name == 'edit'           || controller.action_name == 'update' ||
        controller.action_name == 'add_comment'    || controller.action_name == 'edit_comment'   || controller.action_name == 'create' ||
        controller.action_name == 'create_comment' || controller.action_name == 'update_comment' || controller.action_name == 'new'    %>
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7/tinymce.min.js" referrerpolicy="origin"></script>
    <%= javascript_include_tag 'load-tiny-mce' %>
  <% end %>

  <% if controller.controller_name == 'photo_albums' && controller.action_name == 'show' %>
    <%= stylesheet_link_tag 'colorbox' %>
    <%= javascript_include_tag 'jquery-1.4.2.min' %>
    <%= javascript_include_tag 'colorbox/jquery.colorbox-min' %>
    <script>
      $(document).ready(function(){ $("a[rel='album']").colorbox({maxWidth:"85%", maxHeight:"85%"}); });
    </script>
  <% end %>

	<% if controller.controller_name == 'photo_albums' && (controller.action_name == 'manage_pictures' || controller.action_name == 'add_picture') %>
		<%= javascript_include_tag 'jquery-1.4.2.min' %>
		<%= javascript_include_tag 'test' %>
	<% end %>

</head>
<body>

<div id="main-menu">
  <ul>
    <li>
      <% if controller.controller_name == 'home' && controller.action_name != 'sign_out' %>
        <%= link_to t('menu.home'), { :controller => 'home' }, :class => 'active', :title => t('menu.home_title_active') %>
      <% else %>
        <%= link_to t('menu.home'), {:controller => 'home'}, :title => t('menu.home_title') %>
      <% end %>
    </li>
    <li>
      <% if controller.controller_name == 'news' %>
        <%= link_to t('menu.news'), {:controller => 'news'}, :class => 'active', :title => t('menu.news_title') %>
      <% else %>
        <%= link_to t('menu.news'), {:controller => 'news'}, :title => t('menu.news_title') %>
      <% end %>
    </li>
    <li>
      <% if controller.controller_name == 'photo_albums' %>
        <%= link_to t('menu.albums'), {:controller => 'photo_albums'}, :class => 'active', :title => t('menu.albums_title') %>
      <% else %>
        <%= link_to t('menu.albums'), {:controller => 'photo_albums'}, :title => t('menu.albums_title') %>
      <% end %>
    </li>
    <li>
      <% if controller.controller_name == 'settings' %>
        <%= link_to t('menu.settings'), {:controller => 'settings'}, :class => 'active', :title => t('menu.settings_title') %>
      <% else %>
        <%= link_to t('menu.settings'), {:controller => 'settings'}, :title => t('menu.settings_title') %>
      <% end %>
    </li>
    <li>
      <% if controller.action_name == 'sign_out' %>
        <%= link_to t('menu.sign_out'), {:controller => 'home', :action => 'sign_out'}, :class => 'active', :title => t('menu.sign_out_title') %>
      <% else %>
        <%= link_to t('menu.sign_out'), {:controller => 'home', :action => 'sign_out'}, :title => t('menu.sign_out_title') %>
      <% end %>
    </li>
  </ul>
</div>

<div id="wrapper">
<div id="content-wrapper">

<div id="header">
  <div id="header-content">
    <h1>
      <%= link_to image_tag("header.png", :alt => t('site.logo_alt')), {:controller => 'home', :action => 'index'}, :title => t('site.logo_title') %>
    </h1>
    <p class="sub-title">
      <%= t('site.sub_title') %>
    </p>
  </div>
  <div id="notices">
    <p class="notice"><%= flash[:notice] %></p>
    <p class="error"><%= flash[:error] %></p>
  </div>
</div>

<div id="content">
  <h2>
    <%= @page_title[0] %>
  </h2>
  <%= yield  %>
</div>

</div>
</div>

<div id="footer"></div>

</body>
</html>
