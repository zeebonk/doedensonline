<h2><%= t('.heading') %></h2>

<table>
  <tr>
    <th><%= t('.first_name') %></th>
    <th><%= t('.last_name') %></th>
    <th><%= t('.email') %></th>
    <th><%= t('.password') %></th>
    <th><%= t('.notify_news') %></th>
    <th><%= t('.is_admin') %></th>
  </tr>

<% for user in @users %>
  <tr>
    <td><%=h user.first_name %></td>
    <td><%=h user.last_name %></td>
    <td><%=h user.email %></td>
    <td><%=h user.password %></td>
    <td><%=h user.notify_news %></td>
    <td><%=h user.isadmin %></td>
    <td><%= link_to t('.show'), user %></td>
    <td><%= link_to t('.edit'), edit_user_path(user) %></td>
    <td><%= link_to t('.destroy'), user, :confirm => t('.confirm_destroy'), :method => :delete %></td>
  </tr>
<% end %>
</table>

<br />

<%= link_to t('.new_user'), new_user_path %>
