<%= form_tag :action => 'authenticate' do %>
  <p>
    <%= label :user, :first_name, nil, :for => 'first_name' %>:<br />
    <%= text_field_tag :first_name, params[:first_name] %>
  </p>
  <p>
    <%= label :user, :password, nil, :for => 'password' %>:<br />
    <%= password_field_tag :password, params[:password] %>
  </p>

  <p>
    <%= submit_tag t('.submit') %>
  </p>
<% end %>

<%= link_to t('.back'), users_path %>
