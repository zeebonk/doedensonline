<% content_for :page_title, t('page_titles.news_items_new') %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
<%= form_for @news_item, :url => news_items_path do |f| %>
  <%= error_messages_for(f.object) %>
  <p>
    <%= f.label :message %><br />
    <%= f.text_area :message, :rows => 18, :value => t('.placeholder') %>
  </p>
  <p>
    <%= f.submit t('.submit') %>
  </p>
<% end %>
</div>
<%= link_to t('.back'), news_items_path, :title => t('.back_title'), :class=>'back' %>
