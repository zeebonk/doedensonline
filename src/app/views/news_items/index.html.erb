<% content_for :page_title, t('page_titles.news_items_index') %>

<% page_nav = paginate(@news_items, outer_window: 1) %>

<p class="intro"><%= t('.intro') %></p>

<div class="news-index-actions"><%= page_nav %><%= link_to t('.add'), new_news_item_path, :title => t('.add_title'), :class=>'add' %></div>

<% @news_items.each_with_index do |news_item, index| %>

  <% if (index % 2) == 0 %>
    <div class="balloon-wrapper even">
  <% else %>
    <div class="balloon-wrapper odd">
  <% end %>

    <div class="poster-wrapper">
      <h3>
        <%= news_item.user.first_name %> <%= news_item.user.last_name %>
      </h3>
    </div>

    <div class="balloon-top">
      <div class="balloon-bottom">

        <div class="date-container">
        <%= news_item.created_at.to_fs(:article_date).html_safe %>
        </div>
        <%= rich_text(news_item.message) %>
        <div class="balloon-actions">
          <%= link_to t('.view_comments', :count => news_item.news_comments.size), news_item_path(news_item), :title => t('.view_comments_title') %>
          <% if news_item.user_id == @current_user.id %>
            <%= link_to t('.remove'), remove_news_item_path(news_item), :class=>'edit', :title => t('.remove_title') %>
            <%= link_to t('.edit'), edit_news_item_path(news_item), :class=>'edit', :title => t('.edit_title') %>
          <% end %>
          <br class="clear"/>
        </div>
      </div>
    </div>

    <br class="clear"/>
  </div>
<% end %>

<div class="news-index-actions bottom">
  <%= page_nav %>
  <%= link_to t('.add'), new_news_item_path, :title => t('.add_title'), :class=>'add' %>
</div>
