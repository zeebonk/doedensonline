<% content_for :page_title, t('page_titles.home') %>

<p class="intro"><%= t('.intro_html') %></p>
<div id="balloons-wrapper">
<% for news_item in @news_items %>
  <div class="preview-balloon">
    <div class="preview-balloon-content">
      <%= link_to t('.read_more'), news_item_path(news_item), :title => t('.read_more_title'), :class => 'read-on' %>
      <p>
        <%= news_item.preview(140).html_safe %>
      </p>
    </div>
    <div class="preview-balloon-poster">
      <p>
        <%= news_item.user.first_name %>
        <%= news_item.user.last_name %>
      </p>
    </div>
  </div>
<% end %>
</div>
<%= image_tag "zandvaart.jpg", :class => "zandvaart", :alt => t('.zandvaart_alt') %>
