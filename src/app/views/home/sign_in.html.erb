<% content_for :page_title, t('page_titles.sign_in') %>

<p class="intro"><%= t('.intro') %></p>

<%= form_tag :action => 'authenticate' do %>

<div id="sign-in-form">
<div class="preview-balloon">

<div class="preview-balloon-content sign-in">

  <p>
    <%= label_tag :first_name, t('.first_name') %><br />
    <%= text_field_tag :first_name, params[:first_name], :class => 'text-box' %>
  </p>

  <p>
    <%= label_tag :password, t('.password') %><br />
    <%= password_field_tag :password, params[:password], :class => 'text-box' %>
  </p>

  <p>
    <%= link_to t('.forgot_password'), {:action => 'password_forgotten'}, :class=> 'read-on', :title => t('.forgot_password_title') %>
  </p>

</div>
<div class="preview-balloon-poster">

  <p>
    <%= submit_tag t('.submit'), :class=>'submit' %><br />
  </p>

</div>

</div>
</div>

<% end %>

<br class="clear" />
