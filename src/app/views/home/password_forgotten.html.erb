<% content_for :page_title, t('page_titles.password_forgotten') %>

<p class="intro"><%= t('.intro') %></p>

<%= form_tag :action => 'reset_password' do %>

<div id="sign-in-form">
<div class="preview-balloon">

<div class="preview-balloon-content sign-in">
  <p>
    <%= label_tag :first_name, t('.first_name') %><br />
    <%= text_field_tag :first_name, params[:first_name] %>
  </p>
  <p>
    <%= label_tag :email, t('.email') %><br />
    <%= text_field_tag :email, params[:email] %>
  </p>
</div>
<div class="preview-balloon-poster">
  <p>
    <%= submit_tag t('.submit') %><br />
  </p>
</div>

</div>
</div>

<% end %>

<br class="clear" />
