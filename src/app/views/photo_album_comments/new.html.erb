<% content_for :page_title, t('page_titles.albums_comment_add') %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
  <%= form_for(@photo_album_comment, :url => photo_album_comments_path(@photo_album_comment.photo_album_id)) do |f| %>
    <%= f.error_messages %>
    <p>
      <%= f.label :message %><br />
      <%= f.text_area :message, :rows => 18, :value => t('.placeholder') %>
    </p>
    <p>
      <%= f.submit t('.submit') %>
    </p>
  <% end %>
</div>

<%= link_to t('.back'), photo_album_path(@photo_album_comment.photo_album_id), :class=>'back', :title => t('.back_title') %>
