<% content_for :page_title, t('page_titles.albums_comment_edit') %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
  <%= form_for(@photo_album_comment) do |f| %>
    <p>
      <%= f.hidden_field :id %>
    </p>
    <p>
      <%= f.label :message %><br />
      <%= f.text_area :message, :rows => 18 %>
    </p>
    <p>
      <%= f.submit t('.submit') %>
    </p>
  <% end %>
</div>

<%= link_to t('.back'), {:controller => 'photo_albums', :action => 'show', :id => @photo_album_comment.photo_album_id}, :class=>'back', :title => t('.back_title') %>
