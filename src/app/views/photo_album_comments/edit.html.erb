<% content_for :page_title, t('page_titles.albums_comment_edit') %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
  <%= form_for(@photo_album_comment, :url => photo_album_comment_path(@photo_album_comment.photo_album, @photo_album_comment)) do |f| %>
    <%= error_messages_for(f.object) %>
    <p>
      <%= f.label :message %><br />
      <%= f.text_area :message, :rows => 18 %>
    </p>
    <p>
      <%= f.submit t('.submit') %>
    </p>
  <% end %>
</div>

<%= link_to t('.back'), photo_album_path(@photo_album_comment.photo_album), :class=>'back', :title => t('.back_title') %>
