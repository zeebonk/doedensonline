<% content_for :page_title, t('page_titles.news_edit') %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
<%= form_for @news_item, :url => { :action => "update" } do |f| %>
  <%= f.error_messages %>
  <p><%= f.hidden_field :id %></p>
  <p>
    <%= f.label :message %><br />
    <%= f.text_area :message, :rows => 18 %>
  </p>
  <p>
    <%= f.submit t('.submit') %>
  </p>
<% end %>
</div>
<%= link_to t('.back'), {:action => 'index'}, :title => t('.back_title'), :class=>'back' %>
