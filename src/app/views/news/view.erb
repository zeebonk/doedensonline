<p class="intro"><%= t('.intro') %></p>

<div class="news-index-actions">
  <%= link_to t('.back'), {:action => 'index'}, :title => t('.back_title') %>
  <%= link_to t('.add_comment'), {:action => 'add_comment', :id => @news_item.id}, :title => t('.add_comment_title'), :class=>'next' %>
</div>

<div class="balloon-wrapper even">
  <div class="poster-wrapper">
    <h3>
      <%= @news_item.user.first_name %> <%= @news_item.user.last_name %>
    </h3>
  </div>
  <div class="balloon-top">
    <div class="balloon-bottom">
      <div class="date-container">
      <% Time::DATE_FORMATS[:article_date] = "<span class='day'>%d</span><span class='month-year'>%B<br/>%Y</span>" %>
      <%= @news_item.created_at.to_s(:article_date).html_safe %>
      </div>
      <%= @news_item.message.html_safe %>
      <% if @news_item.user_id == @current_user.id %>
      <div class="balloon-actions">

          <%= link_to t('.remove'), {:action => 'remove', :id => @news_item.id}, :class=>'edit', :title => t('.remove_title') %>
          <%= link_to t('.edit'), {:action => 'edit', :id => @news_item.id}, :class=>'edit', :title => t('.edit_title') %>

        <br class="clear"/>
      </div>
      <% end %>
    </div>
  </div>

</div>
<div id="reactions">
<% for news_comment in @news_comments %>
<div class="balloon-wrapper odd reaction">
  <div class="poster-wrapper">
    <h3>
      <%= news_comment.user.first_name %> <%= news_comment.user.last_name %>
    </h3>
  </div>
  <div class="balloon-top">
    <div class="balloon-bottom">
      <%= news_comment.message.html_safe %>
      <% if news_comment.user.id == @current_user.id %>
      <div class="balloon-actions">

          <%= link_to t('.remove_comment'), {:action => 'remove_comment', :id => news_comment.id}, :class=>'edit', :title => t('.remove_comment_title') %>
          <%= link_to t('.edit_comment'), {:action => 'edit_comment', :id => news_comment.id}, :class=>'edit', :title => t('.edit_comment_title') %>

        <br class="clear"/>
      </div>
      <% end %>
    </div>
  </div>
</div>
<% end %>
</div>
