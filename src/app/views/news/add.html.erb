<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
<%= form_for @news_item, :url => { :action => "create" } do |f| %>
  <p>
    <%= f.text_area :message, :rows => 18, :value => t('.placeholder') %>
  </p>
  <p>
    <%= f.submit t('.submit') %>
  </p>
<% end %>
</div>
<%= link_to t('.back'), {:action => 'index'}, :title => t('.back_title'), :class=>'back' %>
