<% content_for :page_title, "#{t('page_titles.comment_edit')} - #{t('page_titles.news_section')}" %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
  <%= form_for @news_comment, :url => {:action => 'update_comment'} do |f| %>
    <p>
      <%= f.hidden_field :id %>
    </p>
    <p>
      <%= f.text_area :message, :rows => 18 %>
    </p>
    <p>
      <%= f.submit t('.submit') %>
    </p>
  <% end %>
</div>

<%= link_to t('.back'), {:action => 'view', :id => @news_comment.news_item.id}, :class=>'back', :title => t('.back_title') %>
