<% content_for :page_title, t('page_titles.news_comment_remove') %>

<p class="intro"><strong><%= t('.confirmation') %></strong></p>

<%= form_tag :action => 'destroy_comment' do %>
  <p>
    <%= hidden_field_tag "id", @news_comment.id %>
  </p>
  <p>
    <%= submit_tag t('.confirm') %><%= submit_tag t('.cancel') %>
  </p>
<% end %>
