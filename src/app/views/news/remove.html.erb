<% content_for :page_title, t('page_titles.news_remove') %>
<% content_for :page_section, t('page_titles.news_section') %>

<p class="intro"><strong><%= t('.confirmation') %></strong></p>

<%= form_tag :action => 'destroy' do %>
  <p>
    <%= hidden_field_tag 'id', @news_item.id %>
  </p>
  <p>
    <%= submit_tag t('.confirm') %><%= submit_tag t('.cancel') %>
  </p>
<% end %>
