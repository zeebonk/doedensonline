<% content_for :page_title, t('page_titles.news_comment_add') %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
  <%= form_for @news_comment, :url => {:action => 'create_comment'} do |f| %>
    <%= f.error_messages %>
    <p>
      <%= f.hidden_field :news_item_id %>
    </p>
    <p>
      <%= f.label :message %><br />
      <%= f.text_area :message, :rows => 18, :value => t('.placeholder') %>
    </p>
    <p>
      <%= f.submit t('.submit') %>
    </p>
  <% end %>
</div>

<%= link_to t('.back'), {:action => 'view', :id => @news_comment.news_item_id}, :class=>'back', :title => t('.back_title') %>
