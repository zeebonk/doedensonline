<% content_for :page_title, t('page_titles.photo_album_pictures_index') %>

<p class="intro">
	<%= t('.intro') %>
</p>

<h3>
	<%=h @photo_album.title %>
</h3>

<div id="edit-form">
	<%= form_tag photo_album_pictures_path(@photo_album), :multipart => true do %>
		<p>
			<label><%= t('.add_pictures_label') %></label>
		<p>
			<%= file_field_tag 'file[]', multiple: true %>
		</p>
		<p>
			<%= submit_tag t('.upload_submit') %>
		</p>
	<% end %>

	<% if @photo_album.photo_album_pictures.count > 0 %>
	<%= form_tag destroy_many_photo_album_pictures_path(@photo_album) do %>
		<p>
			<label><%= t('.remove_pictures_label') %></label>
		</p>
		<p>
			<div id="pictures-wrapper">
			<ul>
			<% for picture in @photo_album.photo_album_pictures -%>
				<li>
				<a href="#">
				<%= image_tag "/images/small/#{picture.filename} " %>
				</a>
				<%= check_box_tag 'selected[]', picture.id, false, :class => 'checkbox' %>
				</li>
			<% end -%>
			</ul>
			</div>
			<br class="clear">
		</p>
		<p>
			<%= submit_tag t('.remove_submit') %>
		</p>
	<% end %>
	<% end %>
</div>

<%= link_to t('.back'), photo_album_path(@photo_album), :class=>'back' %>
