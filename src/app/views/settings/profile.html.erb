<div id="settings">

  <%= render :partial => 'settings_menu' %>

  <p class="intro"><%= t('.intro') %></p>

  <p style="color: green"><%= flash[:settings] %></p>

  <%= form_for @user, :url => { :action => "update_profile" } do |f| %>
    <%= f.error_messages %>

    <p>
      <%= f.label :first_name, t('.first_name_label') %><br />
      <%= f.text_field :first_name %>
    </p>
    <p>
      <%= f.label :last_name, t('.last_name_label') %><br />
      <%= f.text_field :last_name %>
    </p>
    <p>
      <%= f.label :email, t('.email_label') %><br />
      <%= f.text_field :email %>
    </p>
    <p>
      <%= f.submit t('.submit') %>
    </p>
  <% end %>

  </div>
