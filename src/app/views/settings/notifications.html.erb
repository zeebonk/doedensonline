<div id="settings">

<%= render :partial => 'settings_menu' %>

<p class="intro"><%= t('.intro') %></p>

<p style="color: green"><%= flash[:settings] %></p>

<%= form_for @user, :url => { :action => "update_notifications" } do |f| %>
  <%= f.error_messages %>
  <p>
    <%= f.label :notify_news, t('.notify_news_label') %><br />
    <%= f.check_box :notify_news %>
  </p>
  <p>
    <%= f.submit t('.submit') %>
  </p>
<% end %>

</div>
