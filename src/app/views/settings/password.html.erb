<% content_for :page_title, t('page_titles.settings') %>

<div id="settings">

  <%= render :partial => 'settings_menu' %>

  <p class="intro"><%= t('.intro') %></p>

  <p class="success"><%= flash[:settings] %></p>

  <%= form_for @user, :url => { :action => "update_password" } do |f| %>
    <%= error_messages_for(f.object) %>


    <p>
      <%= f.label :old_password, t('.old_password_label') %><br />
      <%= password_field_tag :old_password, params[:old_password]  %>
    </p>

    <p>
      <%= f.label :password, t('.new_password_label') %><br />
      <%= password_field_tag :password, params[:password]  %>
    </p>

    <p>
      <%= f.label :password_confirmation, t('.new_password_confirmation_label') %><br />
      <%= password_field_tag :password_confirmation, params[:password_confirmation]  %>
    </p>
    <p>
      <%= submit_tag t('.submit') %>
    </p>
  <% end %>

</div>
