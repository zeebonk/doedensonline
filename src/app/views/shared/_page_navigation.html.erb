<ul class="page-navigation">
  <li>
    <% if paginator.first_page? %>
      « nieuwer
    <% else %>
      <%= link_to '« nieuwer', { :action => 'page', :page_number => paginator.prev_page }, :title => 'Ga een pagina verder' %>
    <% end %>
  </li>

  <% paginator.entries.each do |entry| %>
    <% if entry == Paginator::GAP %>
      <li class="gap">…</li>
    <% elsif entry == paginator.current_page %>
      <li><%= entry %></li>
    <% else %>
      <li><%= link_to entry, { :action => 'page', :page_number => entry }, :title => "Ga naar pagina #{entry}" %></li>
    <% end %>
  <% end %>

  <li>
    <% if paginator.last_page? %>
      ouder »
    <% else %>
      <%= link_to 'ouder »', { :action => 'page', :page_number => paginator.next_page }, :title => 'Ga een pagina terug' %>
    <% end %>
  </li>
</ul>
