<% content_for :page_title, t('page_titles.albums_view') %>

<p class="intro">
  <%= t('.intro') %>
</p>

<div class="news-index-actions">
	<%= link_to t('.back'), photo_albums_path %>
	<%= link_to t('.add_comment'), new_photo_album_comment_path(@photo_album), :title => t('.add_comment_title'), :class=>'next' %>
</div>

<div class="balloon-wrapper even">
  <div class="poster-wrapper">
    <h3>
      <%= @photo_album.user.first_name %> <%= @photo_album.user.last_name %>
    </h3>
  </div>
  <div class="balloon-top">
    <div class="balloon-bottom">

      <div class="date-container">
        <%= @photo_album.created_at.to_fs(:article_date).html_safe %>
      </div>

      <%= rich_text(@photo_album.description) %>

      <% if @photo_album.user_id == @current_user.id %>
        <div class="balloon-actions">
					<%= link_to t('.remove'), remove_photo_album_path(@photo_album), :class => "edit" %>
          <%= link_to t('.manage_pictures'), photo_album_pictures_path(@photo_album), :class => "edit" %>
          <%= link_to t('.edit'), edit_photo_album_path(@photo_album), :class => "edit" %>
          <br class="clear"/>
        </div>
      <% end %>

    </div>
  </div>
</div>

<div id="pictures-wrapper">
	<ul>
		<% for picture in @photo_album.photo_album_pictures %>
			<li>
        <%= link_to image_tag("/images/small/#{picture.filename}"), "/images/large/#{picture.filename}", :rel => 'album' %>
			</li>
		<% end %>
	</ul>
	<br class="clear"/>
</div>


<div id="reactions">
<% for photo_album_comment in @photo_album_comments %>
<div class="balloon-wrapper odd reaction">
  <div class="poster-wrapper">
    <h3>
      <%= photo_album_comment.user.first_name %> <%= photo_album_comment.user.last_name %>
    </h3>
  </div>
  <div class="balloon-top">
    <div class="balloon-bottom">
      <%= rich_text(photo_album_comment.message) %>
      <% if photo_album_comment.user.id == @current_user.id %>
      <div class="balloon-actions">

          <%= link_to t('.remove_comment'), remove_photo_album_comment_path(@photo_album, photo_album_comment), :class=>'edit', :title => t('.remove_comment_title') %>
          <%= link_to t('.edit_comment'), edit_photo_album_comment_path(@photo_album, photo_album_comment), :class=>'edit', :title => t('.edit_comment_title') %>

        <br class="clear"/>
      </div>
      <% end %>
    </div>
  </div>
  <br class="clear"/>
</div>
<% end %>
</div>
