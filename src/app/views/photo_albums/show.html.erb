<% content_for :page_title, "#{t('page_titles.albums_view')} - #{t('page_titles.albums_section')}" %>

<p class="intro">
  <%= t('.intro') %>
</p>

<div class="news-index-actions">
	<%= link_to t('.back'), photo_albums_path %>
	<%= link_to t('.add_comment'), {:controller => 'photo_album_comments', :action => 'new', :id => @photo_album.id}, :title => t('.add_comment_title'), :class=>'next' %>
</div>

<div class="balloon-wrapper even">
  <div class="poster-wrapper">
    <h3>
      <%= @photo_album.user.first_name %> <%= @photo_album.user.last_name %>
    </h3>
  </div>
  <div class="balloon-top">
    <div class="balloon-bottom">

      <div class="date-container">
        <% Time::DATE_FORMATS[:article_date] = "<span class='day'>%d</span><span class='month-year'>%B<br/>%Y</span>" %>
        <%= @photo_album.created_at.to_s(:article_date).html_safe %>
      </div>

      <%= @photo_album.description.html_safe %>

      <% if @photo_album.user_id == @current_user.id %>
        <div class="balloon-actions">
					<%= link_to t('.remove'), {:action => 'remove', :id => @photo_album.id }, :class => "edit" %>
          <%= link_to t('.manage_pictures'), {:action => 'manage_pictures', :id => @photo_album.id }, :class => "edit" %>
          <%= link_to t('.edit'), edit_photo_album_path(@photo_album), :class => "edit" %>
          <br class="clear"/>
        </div>
      <% end %>

    </div>
  </div>
</div>

<div id="pictures-wrapper">
	<ul>
		<% for picture in @photo_album.photo_album_pictures %>
			<li>
        <%= link_to image_tag("/images/small/#{picture.filename}"), "/images/large/#{picture.filename}", :rel => 'album' %>
			</li>
		<% end %>
	</ul>
	<br class="clear"/>
</div>


<div id="reactions">
<% for photo_album_comment in @photo_album_comments %>
<div class="balloon-wrapper odd reaction">
  <div class="poster-wrapper">
    <h3>
      <%= photo_album_comment.user.first_name %> <%= photo_album_comment.user.last_name %>
    </h3>
  </div>
  <div class="balloon-top">
    <div class="balloon-bottom">
      <%= photo_album_comment.message.html_safe %>
      <% if photo_album_comment.user.id == @current_user.id %>
      <div class="balloon-actions">

          <%= link_to t('.remove_comment'), {:controller => 'photo_album_comments', :action => 'remove', :id => photo_album_comment.id}, :class=>'edit', :title => t('.remove_comment_title') %>
          <%= link_to t('.edit_comment'), {:controller => 'photo_album_comments', :action => 'edit', :id => photo_album_comment.id}, :class=>'edit', :title => t('.edit_comment_title') %>

        <br class="clear"/>
      </div>
      <% end %>
    </div>
  </div>
  <br class="clear"/>
</div>
<% end %>
</div>
