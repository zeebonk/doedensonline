<% content_for :page_title, t('page_titles.albums_remove') %>
<% content_for :page_section, t('page_titles.albums_section') %>

<p class="intro"><strong><%= t('.confirmation') %></strong></p>

<%= form_tag('/photo_albums/destroy', :method => :post) do %>
  <p>
    <%= hidden_field_tag 'id', @photo_album.id %>
  </p>
  <p>
    <%= submit_tag t('.confirm') %><%= submit_tag t('.cancel') %>
  </p>
<% end %>
