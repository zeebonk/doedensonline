<% content_for :page_title, t('page_titles.albums_index') %>

<p class="intro">
	<%= t('.intro') %>
</p>

<div class="news-index-actions"><%= page_navigation %><%= link_to t('.add'), new_photo_album_path, :class=>'add' %></div>

<div id="photo-albums-wrapper">

  <% for photo_album in @photo_albums %>
    <div class="photo-album">
  	  <%= link_to image_tag("medium/#{photo_album.preview_picture}"), photo_album %>
  	  <h3><%=h photo_album.title %></h3>
    </div>
  <% end %>

  <br class="clear"/>

</div>
