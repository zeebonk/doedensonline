<% content_for :page_title, t('page_titles.albums_new') %>

<p class="intro">
	<%= t('.intro') %>
</p>

<div id="edit-form">
	<%= form_for(@photo_album,:html => { :multipart => true }) do |f| %>
		<p>
			<%= f.label :title %>
			<% if (@title_error) %>
				<span class="error-message"><%= t('.title_error') %></span>
			<% end %>
			<%= f.text_field :title, :class => 'text-box' %>
		</p>
		<p>
			<%= f.label :description %>
			<% if (@description_error) %>
				<span class="error-message"><%= t('.description_error') %></span><br />
			<% end %>
			<%= f.text_area :description, :rows => 12 %>
		</p>
		<p>
			<%= label_tag 'photo_album_pictures', t('.pictures_label') %>
			<% if (@pictures_error) %>
				<span class="error-message"><%= t('.pictures_error') %></span>
			<% end %>
			<br>
			<%= file_field_tag 'photo_album[pictures][]', multiple: true %>
		</p>
		<p>
			<%= f.submit t('.submit') %>
		</p>
	<% end %>
</div>

<%= link_to t('.back'), photo_albums_path, :class => 'back' %>
