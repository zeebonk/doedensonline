<% content_for :page_title, t('page_titles.albums_edit') %>

<p class="intro">
	<%= t('.intro') %>
</p>

<div id="edit-form">
	<%= form_for(@photo_album) do |f| %>
		<%= f.error_messages %>
		<p>
			<%= f.label :title %>
			<%= f.text_field :title, :class => 'text-box' %>
		</p>
		<p>
			<%= f.label :description %>
			<%= f.text_area :description, :rows => 12 %>
		</p>
		<p>
			<%= f.submit t('.submit') %>
		</p>
	<% end %>
</div>

<%= link_to t('.back'), photo_albums_path, :class => 'back' %>
