<p class="intro">
	<%= t('.intro') %>
</p>

<div id="edit-form">
	<%= form_for(@photo_album,:html => { :multipart => true }) do |f| %>
		<p>
			<%= f.label :title, t('.title_label') %>
			<% if (@title_error) %>
				<span class="error-message"><%= t('.title_error') %></span>
			<% end %>
			<%= f.text_field :title, :class => 'text-box' %>
		</p>
		<p>
			<%= f.label :description, t('.description_label') %>
			<% if (@description_error) %>
				<span class="error-message"><%= t('.description_error') %></span><br />
			<% end %>
			<%= f.text_area :description, :rows => 12 %>
		</p>
		<p>
			<label><%= t('.current_preview_picture') %></label><br>
			<%= image_tag "small/" + @photo_album.preview_picture %>
		</p>
		<p>
			<%= f.label :preview_picture, t('.new_preview_picture_label') %>
			<% if (@preview_picture_error) %>
				<span class="error-message"><%= t('.preview_picture_error') %></span>
			<% end %>
			<br>
			<%= f.file_field :preview_picture %>
		</p>
		<p>
			<%= f.submit t('.submit') %>
		</p>
	<% end %>
</div>

<%= link_to t('.back'), photo_albums_path, :class => 'back' %>
