<% content_for :page_title, t('page_titles.albums_edit') %>

<p class="intro">
	<%= t('.intro') %>
</p>

<div id="edit-form">
	<%= form_for(@photo_album,:html => { :multipart => true }) do |f| %>
		<%= f.error_messages %>
		<p>
			<%= f.label :title %>
			<%= f.text_field :title, :class => 'text-box' %>
		</p>
		<p>
			<%= f.label :description %>
			<%= f.text_area :description, :rows => 12 %>
		</p>
		<p>
			<label><%= t('.current_preview_picture') %></label><br>
			<%= image_tag "/images/small/" + @photo_album.preview_picture %>
		</p>
		<p>
			<%= f.label :preview_picture %>
			<br>
			<%= f.file_field :preview_picture %>
		</p>
		<p>
			<%= f.submit t('.submit') %>
		</p>
	<% end %>
</div>

<%= link_to t('.back'), photo_albums_path, :class => 'back' %>
