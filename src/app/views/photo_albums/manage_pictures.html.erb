<% content_for :page_title, t('page_titles.albums_manage_pictures') %>

<p class="intro">
	<%= t('.intro') %>
</p>

<div id="edit-form">
	<%= form_tag('/photo_albums/add_picture', :multipart => true) do %>
		<p>
			<label><%= t('.add_pictures_label') %></label>
		<p>
			<%= file_field_tag 'file[]', multiple: true %>
		</p>
		<p>
			<%= hidden_field_tag 'album_id', @photo_album.id %>
			<%= submit_tag t('.upload_submit') %>
		</p>
	<% end %>

	<% if @photo_album.photo_album_pictures.count > 0 %>
	<%= form_tag('/photo_albums/destroy_many_pictures') do %>
		<p>
			<label><%= t('.remove_pictures_label') %></label>
		</p>
		<p>
			<div id="pictures-wrapper">
			<ul>
			<% for picture in @photo_album.photo_album_pictures -%>
				<li>
				<a href="#">
				<%= image_tag "/images/small/#{picture.filename} " %>
				</a>
				<%= check_box_tag 'selected[]', picture.id, false, :class => 'checkbox' %>
				</li>
			<% end -%>
			</ul>
			</div>
			<br class="clear">
			<%= hidden_field_tag 'album_id', @photo_album.id %>
		</p>
		<p>
			<%= submit_tag t('.remove_submit') %>
		</p>
	<% end %>
	<%end%>
</div>

<%= link_to t('.back'), photo_albums_path, :class=>'back' %>
