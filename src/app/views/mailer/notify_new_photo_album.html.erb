<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="nl">

  <head>
    <meta http-equiv="Content-Type" content="text/html;charset=UTF-8" />
  </head>

  <body>
    <p>
      <%= t('.greeting') %>
    </p>
    <p>
      <%= t('.posted_by', :name => "#{h @photo_album.user.first_name} #{h @photo_album.user.last_name}") %>
    </p>
    <p>
      <%= t('.link_prefix') %> <%= link_to t('.link_text'), "http://www.doedensonline.nl/photo_albums/#{@photo_album.id}" %> <%= t('.link_suffix') %>
    </p>
    <p>
      <%= t('.closing') %>
    </p>
    <p>
      <%= t('.signature') %>
    </p>
    <p>
      <%= t('.ps') %>
    </p>
  </body>

</html>
