<% content_for :page_title, t('page_titles.news_comments_edit') %>

<p class="intro"><%= t('.intro') %></p>

<div id="edit-form">
  <%= form_for @news_comment, :url => news_item_news_comment_path(@news_comment.news_item, @news_comment) do |f| %>
    <%= f.error_messages %>
    <p>
      <%= f.label :message %><br />
      <%= f.text_area :message, :rows => 18 %>
    </p>
    <p>
      <%= f.submit t('.submit') %>
    </p>
  <% end %>
</div>

<%= link_to t('.back'), news_item_path(@news_comment.news_item), :class=>'back', :title => t('.back_title') %>
